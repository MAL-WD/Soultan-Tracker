# ============================================
# SOLTAN SM TRACKER - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and update the values
# DO NOT commit .env to git!

# ============================================
# MONGODB CONNECTION
# ============================================
# Option 1: Local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/soltan-tracker

# Option 2: MongoDB Atlas (Cloud - Recommended)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/soltan-tracker
# Get your connection string from: https://www.mongodb.com/cloud/atlas

# ============================================
# SERVER CONFIGURATION
# ============================================
# Port where backend server will run
PORT=5000

# ============================================
# AUTHENTICATION
# ============================================
# JWT Secret - Change this to a secure random string!
# Example: openssl rand -base64 32
JWT_SECRET=your_very_secret_key_change_this_12345

# ============================================
# ENVIRONMENT
# ============================================
# Set to 'development' for local development
# Set to 'production' for deployment
NODE_ENV=development

# ============================================
# LOGGING
# ============================================
# Optional: Set to 'true' to enable detailed logs
DEBUG=false

